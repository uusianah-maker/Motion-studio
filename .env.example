# Salin jadi .env.local (gitignored) lalu isi. Panduan: docs/SETUP_GOOGLE_LOGIN.md
# Jangan pernah commit .env.local atau menempel isinya ke chat.

MOTION_WORKSPACE=
# MOTION_PORT=4317

# Login Google (W09): isi ketiganya = login Google wajib. Kosong semua = mode token URL lokal.
MOTION_GOOGLE_CLIENT_ID=
MOTION_GOOGLE_CLIENT_SECRET=
MOTION_ALLOWED_EMAILS=

# Peran (U7, opsional; hanya dengan login Google). Kosong semua = semua akun Owner.
# Bila dipakai: wajib minimal satu owner; email yang tidak tercantum = Reviewer.
# MOTION_OWNER_EMAILS=
# MOTION_EDITOR_EMAILS=
# MOTION_REVIEWER_EMAILS=

# Mesin Generate Otomatis / Batch Remix (U6, opsional)
# MOTION_ENGINE_ROOT=D:\VIBECODING\remotion

# Opsional
# MOTION_PUBLIC_URL=https://motion.domainlo.com  # online lewat VPS (deploy/README.md); wajib login Google
# MOTION_STATE_DIR=                              # default %USERPROFILE%\.motion-studio
# MOTION_SECRET_KEY=                             # 64 hex; default file secret.key di MOTION_STATE_DIR
