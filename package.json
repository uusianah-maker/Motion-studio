{
  "name": "motion-studio-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -b apps/server",
    "typecheck": "tsc -p packages/core/tsconfig.test.json && tsc -p apps/server/tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run --root packages/core && vitest run --root apps/server",
    "smoke": "node scripts/smoke-layout.mjs",
    "test:prototype": "node audit/T01/audit.mjs",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test && npm run smoke",
    "test:e2e": "npm run build && node audit/E2E/e2e.mjs",
    "start:server": "npm run build && node apps/server/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "bin": {
    "motion-storage": "packages/core/dist/cli/motion-storage.js"
  }
}
